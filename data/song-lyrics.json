    "lines": [
      {"startBeat":0,"endBeat":8,"ko":"꽃잎에 살며시","en":"Butterfly, flutter by,"},
      {"startBeat":8,"endBeat":16,"ko":"고운 날개 쉬어가","en":"Paint the garden as you fly."},
      {"startBeat":16,"endBeat":24,"ko":"햇살이 따스해","en":"Butterfly, in the sky,"},
      {"startBeat":24,"endBeat":32,"ko":"다시 날아봐","en":"Spread your wings and fly."},
      {"startBeat":32,"endBeat":40,"ko":"풀잎 위로 한 바퀴","en":"Round the meadow, soft and slow,"},
      {"startBeat":40,"endBeat":48,"ko":"꽃향기를 따라서","en":"Where the little flowers grow."},
